# Ignore environnements, caches, builds et secrets ; garde les exemples .env.example.
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/
node_modules/
.angular/
coverage/
playwright-report/
test-results/
.env
.env.*
!.env.example
*.log
.DS_Store
Thumbs.db

# Base SQLite locale ; aucun fichier de données ne doit être versionné.
*.sqlite3
*.sqlite3-*

# État Firebase local et éventuelles clés : jamais versionner les identifiants.
.firebase/
.firebaserc
*service-account*.json
firebase-adminsdk-*.json
